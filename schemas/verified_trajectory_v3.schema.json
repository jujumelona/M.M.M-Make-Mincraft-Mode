{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmm.local/schemas/verified_trajectory_v3.schema.json",
  "title": "MMM Verified Trajectory v3",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "storage_format",
    "task_class",
    "stage",
    "task_shape",
    "outcome",
    "verification",
    "procedure",
    "verified_facts",
    "trajectory_id"
  ],
  "properties": {
    "schema_version": {"const": "mmm/verified-trajectory-v3"},
    "record_type": {"const": "verified_trajectory"},
    "storage_format": {"const": "jsonl"},
    "task_class": {
      "type": "string",
      "enum": ["repair", "generation", "build", "runtime", "quality", "research", "planning", "release", "general"]
    },
    "stage": {"type": "string", "maxLength": 160},
    "task_shape": {
      "type": "object",
      "properties": {
        "node_id": {"type": "string", "maxLength": 160},
        "stage": {"type": "string", "maxLength": 160},
        "kind": {"type": "string", "maxLength": 160},
        "generation_stage": {"type": "string", "maxLength": 160},
        "member_ids": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "maxLength": 256}
        }
      },
      "additionalProperties": false
    },
    "outcome": {"type": "string", "enum": ["SUCCESS", "FAIL"]},
    "verification": {
      "type": "object",
      "required": [
        "schema_version", "level", "level_index", "failure_level",
        "failure_level_index", "confidence", "memory_eligible",
        "strong_skill_eligible", "remote_eligible", "verified_failure",
        "reproduced", "checks", "verifier_chain", "policy"
      ],
      "properties": {
        "schema_version": {"const": "mmm/trajectory-verification-v1"},
        "level": {"type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]},
        "level_index": {"type": "integer", "minimum": 0, "maximum": 5},
        "failure_level": {"type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]},
        "failure_level_index": {"type": "integer", "minimum": 0, "maximum": 5},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "memory_eligible": {"type": "boolean"},
        "strong_skill_eligible": {"type": "boolean"},
        "remote_eligible": {"type": "boolean"},
        "verified_failure": {"type": "boolean"},
        "reproduced": {"type": "boolean"},
        "reproduction_basis": {"type": "string", "enum": ["none", "explicit", "independent-clean-snapshot"]},
        "checks": {
          "type": "object",
          "required": ["static", "build", "tests", "runtime", "acceptance"],
          "properties": {
            "static": {"type": "boolean"}, "build": {"type": "boolean"},
            "tests": {"type": "boolean"}, "runtime": {"type": "boolean"},
            "acceptance": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "verifier_chain": {
          "type": "array", "maxItems": 48,
          "items": {
            "type": "object", "required": ["kind", "status", "source"],
            "properties": {
              "kind": {"type": "string"},
              "status": {"type": "string", "enum": ["PASS", "FAIL"]},
              "source": {"type": "string", "maxLength": 240},
              "details": {"type": "object"}
            },
            "additionalProperties": false
          }
        },
        "error_present": {"type": "boolean"},
        "policy": {"type": "string"}
      },
      "additionalProperties": false
    },
    "procedure": {
      "type": "object",
      "required": ["schema_version", "ordered", "steps"],
      "properties": {
        "schema_version": {"const": "mmm/procedure-trace-v1"},
        "ordered": {"const": true},
        "steps": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["index", "kind", "action", "effects"],
            "properties": {
              "index": {"type": "integer", "minimum": 0, "maximum": 31},
              "kind": {"type": "string", "enum": ["tool", "action", "operation", "verifier"]},
              "action": {"type": "string", "minLength": 1, "maxLength": 160},
              "effects": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 160}},
              "status": {"type": "string", "enum": ["PASS", "FAIL"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "verified_facts": {"type": "object"},
    "error_signature": {"type": "string", "maxLength": 1200},
    "trajectory_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "remote_format_version": {"const": "v3"},
    "remote_record_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
