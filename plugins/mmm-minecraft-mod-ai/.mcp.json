{
  "mcpServers": {
    "mmm-frontdoor": {
      "command": "python",
      "args": ["-m", "minecraft_mod_ai.mcp_server"],
      "env": {
        "MMM_MCP_STAGE": "frontdoor",
        "MMM_MODEL_PROFILE": "t4_local",
        "MMM_WORKSPACE": "mmm-output"
      }
    },
    "mmm-research": {
      "command": "python",
      "args": ["-m", "minecraft_mod_ai.mcp_server"],
      "env": {
        "MMM_MCP_STAGE": "research",
        "MMM_MODEL_PROFILE": "t4_local",
        "MMM_WORKSPACE": "mmm-output"
      }
    },
    "mmm-generation": {
      "command": "python",
      "args": ["-m", "minecraft_mod_ai.mcp_server"],
      "env": {
        "MMM_MCP_STAGE": "generation",
        "MMM_MODEL_PROFILE": "t4_local",
        "MMM_WORKSPACE": "mmm-output"
      }
    },
    "mmm-quality": {
      "command": "python",
      "args": ["-m", "minecraft_mod_ai.mcp_server"],
      "env": {
        "MMM_MCP_STAGE": "quality",
        "MMM_MODEL_PROFILE": "t4_local",
        "MMM_WORKSPACE": "mmm-output"
      }
    },
    "mmm-runtime": {
      "command": "python",
      "args": ["-m", "minecraft_mod_ai.mcp_server"],
      "env": {
        "MMM_MCP_STAGE": "runtime",
        "MMM_MODEL_PROFILE": "t4_local",
        "MMM_WORKSPACE": "mmm-output"
      }
    },
    "mmm-release": {
      "command": "python",
      "args": ["-m", "minecraft_mod_ai.mcp_server"],
      "env": {
        "MMM_MCP_STAGE": "release",
        "MMM_MODEL_PROFILE": "t4_local",
        "MMM_WORKSPACE": "mmm-output"
      }
    },
    "mmm-training": {
      "command": "python",
      "args": ["-m", "minecraft_mod_ai.mcp_server"],
      "env": {
        "MMM_MCP_STAGE": "training",
        "MMM_MODEL_PROFILE": "t4_local",
        "MMM_WORKSPACE": "mmm-output"
      }
    },
    "minecraft-dev": {
      "command": "npx",
      "args": ["-y", "@mcdxai/minecraft-dev-mcp@1.2.4"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.78", "--headless"]
    }
  }
}
